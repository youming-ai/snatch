# ===========================================
# Snatch - Environment Configuration
# ===========================================
# Copy this file to .env and modify as needed.
#
# Architecture: a single Hono app serves the built TanStack Start static client
# and the /api routes on one origin, resolving and processing media via yt-dlp + ffmpeg.

# ===========================================
# Docker Compose
# ===========================================

# Host port for the app (serves UI + API). The container listens on 3001.
APP_PORT=38700

# CORS — comma-separated web origins allowed to call /api cross-origin.
# The all-in-one Docker build serves the SPA same-origin and needs none
# (leave empty to reject all cross-origin requests — secure default).
ALLOWED_ORIGINS=

# ===========================================
# API rate limiting
# ===========================================
API_RATE_LIMIT_MAX=30
API_RATE_LIMIT_WINDOW=60000

# Client-address header for rate limiting. `cf-connecting-ip` and
# `fly-client-ip` are trusted automatically; behind any other reverse proxy set
# the header it overwrites with the caller's address (Nginx: `x-real-ip`).
# Leave empty to bucket by user agent instead — every caller sharing one browser
# version then shares one bucket, so set this on a public instance.
# Do not point this at an appending `x-forwarded-for`: callers can rotate it.
API_IP_HEADER=

# ===========================================
# Observability
# ===========================================
# Pino threshold for API request/error logs.
LOG_LEVEL=info
# API Sentry DSN. Leave empty to disable API error reporting.
SENTRY_DSN=

# ===========================================
# Security
# ===========================================
# Optional API key to gate /api/* on a self-hosted instance. When unset (the
# default) the API is public. When set, requests must send
# `Authorization: Api-Key <value>` — the web client's Settings drawer does.
API_KEY=

# Secret key used to HMAC-sign resolved media URLs before returning them to
# the client. Protects the proxy and download endpoints.
# If empty, a random key is generated in memory at startup. For multi-replica
# or restart-stable production deployments, set this to a fixed secret.
PROXY_SIGNING_KEY=

# Cookie jar for yt-dlp, in Netscape format, exported from a logged-in browser.
# Needed because many sites refuse a datacenter IP: from a cloud host YouTube
# answers "Sign in to confirm you're not a bot" without cookies. Leave empty to
# run cookie-less (only sites that do not gate on a login will work).
#
# The container must be able to see the file, e.g. uncomment the bind mount in
# docker-compose.yml and point this at the path inside the container:
#   YTDLP_COOKIES_FILE=/secrets/cookies.txt
# Mount the file itself rather than its directory — a bind mount of a missing
# host file is created as a directory, which the app rejects and reports at boot.
YTDLP_COOKIES_FILE=

# ===========================================
# Local frontend dev (packages/web)
# ===========================================
# Where the Vite dev server proxies /api during `bun dev`. Defaults to the
# local API.
VITE_API_TARGET=http://localhost:3001

# ===========================================
# Frontend build (packages/web)
# ===========================================
# All three are baked into the static client at build time (Docker build args),
# so rebuild the image after changing them.
# Browser Sentry DSN. Leave empty to disable browser error reporting.
VITE_SENTRY_DSN=

# Public origin this instance is served from, e.g. https://snatch.example.com.
# Drives the canonical link, og:url and the social preview image. Leave empty to
# omit them entirely — the right default for a self-hosted instance.
VITE_SITE_URL=

# Microsoft Clarity project id. Leave empty to ship no analytics script at all.
VITE_CLARITY_ID=
